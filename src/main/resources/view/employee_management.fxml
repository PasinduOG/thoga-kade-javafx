            <TextField fx:id="txtEmployeeSalary" layoutX="189.0" layoutY="162.0" promptText="Employee Salary" />
            <TextField fx:id="txtContactNumber" layoutX="378.0" layoutY="162.0" promptText="Contact Number" />
