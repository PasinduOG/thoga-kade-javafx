          <TableColumn fx:id="colEmployeeId" prefWidth="53.0" text="ID" />
          <TableColumn fx:id="colEmployeeName" prefWidth="67.0" text="Name" />
            <TableColumn fx:id="colEmployeeNic" prefWidth="69.33334350585938" text="NIC" />
            <TableColumn fx:id="colDateOfBirth" prefWidth="85.33331298828125" text="Date Of Birth" />
            <TableColumn fx:id="colPosition" prefWidth="83.3333740234375" text="Position" />
            <TableColumn fx:id="colEmployeeSalary" text="Salary" />
            <TableColumn fx:id="colContactNumber" prefWidth="57.33331298828125" text="Contact" />
            <TableColumn fx:id="colEmployeeAddress" prefWidth="84.6666259765625" text="Address" />
            <TableColumn fx:id="colJoinedDate" prefWidth="77.3333740234375" text="Joined Date" />
            <TableColumn fx:id="colStatus" prefWidth="59.99993896484375" text="Status" />
        </columns>
      </TableView>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" />
