            <TextField fx:id="txtEmployeeId" layoutX="110.0" layoutY="64.0" promptText="Employee ID" />
            <TextField fx:id="txtEmployeeName" layoutX="286.0" layoutY="64.0" promptText="Employee Name" />
            <TextField fx:id="txtEmployeeNic" layoutX="462.0" layoutY="64.0" promptText="Employee NIC" />
            <TextField fx:id="txtEmployeePosition" layoutX="110.0" layoutY="114.0" promptText="Employee Position" />
