<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.SupplierController">
   <children>
      <ImageView fx:id="rootPane" fitHeight="500.0" fitWidth="800.0" pickOnBounds="true">
         <image>
            <Image url="@../img/thogakade2.png" />
         </image>
      </ImageView>
      <AnchorPane opacity="0.5" prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: Black;" />
      <TableView fx:id="tblSupplierDetails" layoutX="40.0" layoutY="280.0" prefHeight="206.0" prefWidth="722.0">
        <columns>
          <TableColumn fx:id="colSupplierId" prefWidth="53.0" text="ID" />
          <TableColumn fx:id="colSupplierName" prefWidth="67.0" text="Name" />
            <TableColumn fx:id="colCompanyName" prefWidth="89.0" text="Company" />
            <TableColumn fx:id="colPhone" prefWidth="84.0" text="Phone" />
            <TableColumn fx:id="colEmail" prefWidth="89.0" text="Email" />
            <TableColumn fx:id="colSupplierAddress" prefWidth="93.0" text="Address" />
            <TableColumn fx:id="colCity" prefWidth="70.0" text="City" />
            <TableColumn fx:id="colProvince" prefWidth="89.0" text="Province" />
            <TableColumn fx:id="colPostalCode" prefWidth="87.0" text="Postal Code" />
        </columns>
      </TableView>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" />
      <AnchorPane layoutX="40.0" layoutY="13.0" prefHeight="256.0" prefWidth="722.0" style="-fx-background-color: White;">
         <children>
            <TextField fx:id="txtSupplierId" layoutX="107.0" layoutY="68.0" promptText="Supplier ID" />
            <TextField fx:id="txtSupplierName" layoutX="283.0" layoutY="68.0" promptText="Supplier Name" />
            <TextField fx:id="txtCompanyName" layoutX="459.0" layoutY="68.0" promptText="Company Name" />
            <TextField fx:id="txtSupplierAddress" layoutX="107.0" layoutY="118.0" promptText="Supplier Address" />
            <TextField fx:id="txtCity" layoutX="283.0" layoutY="118.0" promptText="City" />
            <TextField fx:id="txtProvince" layoutX="459.0" layoutY="118.0" promptText="Province" />
            <TextField fx:id="txtPostalCode" layoutX="107.0" layoutY="167.0" promptText="Postal Code" />
            <TextField fx:id="txtPhoneNumber" layoutX="283.0" layoutY="167.0" promptText="Phone Number" />
            <TextField fx:id="txtEmail" layoutX="459.0" layoutY="167.0" promptText="Email Address" />
            <Text layoutX="199.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Supplier Management">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Text>
            <Button layoutX="128.0" layoutY="214.0" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="25.0" prefWidth="95.0" text="Add" />
            <Button layoutX="251.0" layoutY="214.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="25.0" prefWidth="95.0" text="Update" />
            <Button layoutX="373.0" layoutY="214.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="25.0" prefWidth="95.0" text="Delete" />
            <Button layoutX="495.0" layoutY="214.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="25.0" prefWidth="95.0" text="Clear Form" />
            <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnBackOnAction" text="Back to Dashboard" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
