<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.LoginController">
   <children>
      <ImageView fx:id="rootPane" fitHeight="400.0" fitWidth="704.0" pickOnBounds="true">
         <image>
            <Image url="@../img/thogakade1.jpg" />
         </image>
      </ImageView>
      <AnchorPane opacity="0.5" prefHeight="400.0" prefWidth="704.0" style="-fx-background-color: Black;" />
      <AnchorPane layoutX="189.0" layoutY="64.0" prefHeight="269.0" prefWidth="324.0" style="-fx-background-color: White;">
         <children>
            <Text layoutX="63.0" layoutY="52.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Login to Thoga Kade">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Text>
            <TextField fx:id="txtUsername" layoutX="74.0" layoutY="102.0" prefHeight="25.0" prefWidth="171.0" promptText="Enter Username" />
            <PasswordField fx:id="txtPassword" layoutX="74.0" layoutY="159.0" prefHeight="25.0" prefWidth="172.0" promptText="Enter Password" />
            <Text layoutX="74.0" layoutY="97.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Username" />
            <Text layoutX="74.0" layoutY="154.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" />
            <Button layoutX="75.0" layoutY="197.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="25.0" prefWidth="65.0" text="Login" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
