<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.ItemController">
   <children>
      <ImageView fx:id="rootPane" fitHeight="500.0" fitWidth="800.0" pickOnBounds="true">
         <image>
            <Image url="@../img/thogakade2.png" />
         </image>
      </ImageView>
      <AnchorPane opacity="0.5" prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: Black;" />
      <TableView fx:id="tblItemDetails" layoutX="40.0" layoutY="240.0" prefHeight="247.0" prefWidth="722.0">
        <columns>
          <TableColumn fx:id="colItemCode" prefWidth="75.0" text="Item Code" />
          <TableColumn fx:id="colDescription" prefWidth="309.6666717529297" text="Description" />
            <TableColumn fx:id="colCategory" prefWidth="111.33332824707031" text="Category" />
            <TableColumn fx:id="colQty" prefWidth="76.0" text="Quantity" />
            <TableColumn fx:id="colUnitPrice" prefWidth="149.33334350585938" text="Unit Price" />
        </columns>
      </TableView>
      <AnchorPane prefHeight="200.0" prefWidth="200.0" />
      <AnchorPane layoutX="40.0" layoutY="13.0" prefHeight="216.0" prefWidth="722.0" style="-fx-background-color: White;">
         <children>
            <TextField fx:id="txtItemCode" editable="false" layoutX="107.0" layoutY="68.0" promptText="Item Code" />
            <TextField fx:id="txtCategory" layoutX="107.0" layoutY="118.0" promptText="Category" />
            <TextField fx:id="txtDescription" layoutX="283.0" layoutY="68.0" prefHeight="25.0" prefWidth="325.0" promptText="Description" />
            <TextField fx:id="txtQty" layoutX="283.0" layoutY="118.0" promptText="Quantity" />
            <TextField fx:id="txtUnitPrice" layoutX="459.0" layoutY="118.0" promptText="Unit Price" />
            <Text layoutX="228.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Item Management">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Text>
            <Button layoutX="128.0" layoutY="167.0" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="25.0" prefWidth="95.0" text="Add" />
            <Button layoutX="251.0" layoutY="167.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="25.0" prefWidth="95.0" text="Update" />
            <Button layoutX="373.0" layoutY="167.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="25.0" prefWidth="95.0" text="Delete" />
            <Button layoutX="495.0" layoutY="167.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="25.0" prefWidth="95.0" text="Clear Form" />
            <Button layoutX="10.0" layoutY="11.0" mnemonicParsing="false" onAction="#btnBackOnAction" text="Back to Dashboard" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
